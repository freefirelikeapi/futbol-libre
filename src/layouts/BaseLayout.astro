---
interface Props {
  title: string;
  description: string;
  keywords: string;
  canonicalPath: string;
  ogImage?: string;
}

const { title, description, keywords, canonicalPath, ogImage = '/images/futbollibre.ab86b.png' } = Astro.props;
const siteUrl = 'https://futbollibre.life';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogImageUrl = `${siteUrl}${ogImage}`;
---
<!DOCTYPE html>
<html lang="es" class="h-full antialiased">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={canonicalUrl}>
  <link rel="icon" href="/images/favicon.ico" sizes="any">
  <link rel="icon" href="/images/logo-futbol-libre.ab86b.webp" type="image/webp" sizes="96x96">
  <link rel="preload" href="/fonts/geist-latin-wght-normal.BgDaEnEv.8b81b.woff2" as="font" type="font/woff2" crossorigin>
  <!-- Open Graph -->
  <meta property="og:locale" content="es_MX">
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content="Fútbol Libre TV">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:width" content="512">
  <meta property="og:image:height" content="512">
  <!-- Twitter -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>
  <slot name="head" />
  <link rel="stylesheet" href="/css/base.css">
</head>
<body class="min-h-full flex flex-col bg-white text-gray-900">

<header class="sticky top-0 z-40 flex items-center justify-between bg-white px-4 py-4 shadow-[0_4px_6px_rgba(0,0,0,0.1)]">
  <a href="/" class="flex items-center gap-2 no-underline">
    <img src="/images/logo-futbol-libre.ab86b.webp" alt="Logo de Fútbol Libre TV" width="96" height="96" class="h-10 w-10 object-contain">
    <span class="text-2xl font-bold text-green-600">Fútbol Libre TV</span>
  </a>
  <nav class="hidden gap-4 md:flex">
    <a href="/" class="text-sm font-semibold text-gray-600 transition-colors hover:text-green-600">Inicio</a>
    <a href="/deportes" class="text-sm font-semibold text-gray-600 transition-colors hover:text-green-600">Deportes</a>
    <a href="/" class="text-sm font-semibold text-gray-600 transition-colors hover:text-green-600">Canales</a>
    <a href="/nosotros" class="text-sm font-semibold text-gray-600 transition-colors hover:text-green-600">Nosotros</a>
    <a href="/contacto" class="text-sm font-semibold text-gray-600 transition-colors hover:text-green-600">Contacto</a>
  </nav>
  <button id="menu-toggle" class="text-gray-600 md:hidden" aria-label="Abrir menú" aria-expanded="false">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>
</header>

<!-- Mobile menu overlay -->
<div id="menu-overlay" class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-800/75">
  <div class="relative w-11/12 max-w-xs rounded-lg bg-white p-6 shadow-xl">
    <button id="menu-close" class="absolute right-4 top-4 text-gray-600" aria-label="Cerrar menú">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <nav class="mt-4 flex flex-col items-center gap-4">
      <a href="/" class="w-full rounded py-2 text-center text-lg font-semibold text-gray-600 transition-colors hover:bg-green-600 hover:text-white">Inicio</a>
      <a href="/deportes" class="w-full rounded py-2 text-center text-lg font-semibold text-gray-600 transition-colors hover:bg-green-600 hover:text-white">Deportes</a>
      <a href="/" class="w-full rounded py-2 text-center text-lg font-semibold text-gray-600 transition-colors hover:bg-green-600 hover:text-white">Canales</a>
      <a href="/nosotros" class="w-full rounded py-2 text-center text-lg font-semibold text-gray-600 transition-colors hover:bg-green-600 hover:text-white">Nosotros</a>
      <a href="/contacto" class="w-full rounded py-2 text-center text-lg font-semibold text-gray-600 transition-colors hover:bg-green-600 hover:text-white">Contacto</a>
    </nav>
  </div>
</div>

<script is:inline>
  var e=document.getElementById('menu-toggle'),t=document.getElementById('menu-overlay'),n=document.getElementById('menu-close'),r=function(){t?.classList.remove('hidden');t?.classList.add('flex');e?.setAttribute('aria-expanded','true')},i=function(){t?.classList.add('hidden');t?.classList.remove('flex');e?.setAttribute('aria-expanded','false')};e?.addEventListener('click',r);n?.addEventListener('click',i);t?.addEventListener('click',function(ev){ev.target===t&&i()});t?.querySelectorAll('a').forEach(function(a){a.addEventListener('click',i)});
</script>

<main class="mx-auto my-3 w-[91.66%] max-w-3xl flex-1">
  <slot />
</main>

<footer class="mt-auto bg-gray-800 py-4 text-white">
  <div class="mx-auto flex w-[91.66%] max-w-3xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <span class="text-sm">Fútbol Libre TV TV 2026</span>
    <ul class="flex flex-wrap gap-4">
      <li><a href="/nosotros" class="text-sm text-white transition-colors hover:text-green-600">Nosotros</a></li>
      <li><a href="/contacto" class="text-sm text-white transition-colors hover:text-green-600">Contacto</a></li>
      <li><a href="/politica-de-privacidad" class="text-sm text-white transition-colors hover:text-green-600">Privacidad</a></li>
      <li><a href="/terminos-y-condiciones" class="text-sm text-white transition-colors hover:text-green-600">Términos</a></li>
      <li><a href="/dmca" class="text-sm text-white transition-colors hover:text-green-600">DMCA</a></li>
      <li><a href="/deportes" class="text-sm text-white transition-colors hover:text-green-600">Deportes en vivo</a></li>
      <li><a href="/" class="text-sm text-white transition-colors hover:text-green-600">Canales en vivo</a></li>
    </ul>
  </div>
  <!-- Histats.com visitor counter (hidden) -->
  <div style="display:none;">
    <div id="histats_counter"></div>
    <script is:inline>
      var _Hasync = _Hasync || [];
      _Hasync.push(['Histats.start', '1,5060148,4,511,95,18,00000000']);
      _Hasync.push(['Histats.fasi', '1']);
      _Hasync.push(['Histats.track_hits', '']);
      (function () {
        var hs = document.createElement('script');
        hs.type = 'text/javascript';
        hs.async = true;
        hs.src = '//s10.histats.com/js15_as.js';
        (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(hs);
      })();
    </script>
    <noscript><a href="/" target="_blank"><img src="/images/0.5ef53.gif" alt="web hit counter" border="0"></a></noscript>
  </div>
</footer>

</body>
</html>
