    const params=new URLSearchParams(location.search);
    let url=params.get("url")||"";
    if(url){try{const inner=new URL(url);const r=inner.searchParams.get("r");if(r){let b=r.replace(/ /g,"+");b+="=".repeat((4-b.length%4)%4);const d=atob(b);if(/^https?:\/\//i.test(d))url=d}}catch(e){}}
